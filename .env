# app
APP_NAME=ClipHistory
APP_BUNDLE_ID=pro.nekooo.ClipHistory
APP_VERSION=1.5.0
EXECUTABLE_NAME=ClipHistory

# src
SRC_FILE=src/main.mm
ICON_PNG=src/icon.png
ICON_ICNS_NAME=AppIcon

# build
BUILD_DIR=build
DIST_DIR=app
DMG_NAME=ClipHistory.dmg

# compile setting
CXX=clang++
CXXFLAGS="-O2 -std=c++17"
FRAMEWORKS="-framework Cocoa -framework Foundation"